generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cartapp_api"]
}

// ENUMS
enum TransactionType {
  DEPOSIT
  PURCHASE
  SALE

  @@schema("cartapp_api")
}

// USERS
model users {
  id       Int    @id @default(autoincrement())
  email    String @unique(map: "uk6dotkott2kjsp8vw4d0m25fb7") @db.VarChar(255)
  password String @db.VarChar(255)
  username String @unique(map: "ukr43af9ap4edm43mmtq01oddj6") @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cart        cart?
  users_roles users_roles[]
  orders      orders[]
  wallet      wallet?

  @@schema("cartapp_api")
}

// ROLES
model roles {
  id   Int    @id @default(autoincrement())
  name String @unique(map: "ukofx66keruapi6vyqpv6f2or37") @db.VarChar(255)

  users_roles users_roles[]

  @@schema("cartapp_api")
}

// USER ↔ ROLE
model users_roles {
  user_id Int
  role_id Int

  users users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk2o0jvgh89lemvvo17cbqvdxaa")

  roles roles @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkj6m8fwv7oqv74fcehir1a9ffy")

  @@unique([user_id, role_id], map: "ukq3r1u8cne2rw2hkr899xuh7vj")
  @@schema("cartapp_api")
}

// CART
model cart {
  id      Int @id @default(autoincrement())
  user_id Int @unique(map: "uk9emlp6m95v5er2bcqkjsw48he")

  users users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkg5uhi8vpsuy0lgloxk2h4w5o6")

  cart_item cart_item[]

  @@schema("cartapp_api")
}

// CART ITEMS
model cart_item {
  id         Int @id @default(autoincrement())
  quantity   Int
  cart_id    Int
  product_id Int

  cart     cart     @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk1uobyhgl1wvgt1jpccia8xxs3")
  products products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkqkqmvkmbtiaqn2nfqf25ymfs2")

  @@unique([cart_id, product_id], map: "uk_cart_product")
  @@schema("cartapp_api")
}

// PRODUCTS
model products {
  id              Int     @id @default(autoincrement())
  description     String  @db.VarChar(255)
  name            String  @db.VarChar(255)
  price           Decimal @db.Decimal(12, 2)
  stock           Int
  image_url       String  @db.VarChar(255)
  image_public_id String  @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cart_item  cart_item[]
  orderItems order_items[]

  @@schema("cartapp_api")
}

// WALLET
model wallet {
  id      Int     @id @default(autoincrement())
  user_id Int     @unique
  balance Decimal @default(0) @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkg5uhi8vpsuy0lgloxk2h4w5o6")

  transactions transactions[]

  @@schema("cartapp_api")
}

// TRANSACTIONS
model transactions {
  id        Int             @id @default(autoincrement())
  wallet_id Int
  order_id  Int?
  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)

  created_at DateTime @default(now())

  wallet wallet  @relation(fields: [wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order  orders? @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([wallet_id])
  @@index([order_id])
  @@schema("cartapp_api")
}

// ORDERS
model orders {
  id      Int     @id @default(autoincrement())
  user_id Int
  total   Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())

  order_items  order_items[]
  transactions transactions[]

  users users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk1g0x3j6q7v5k1l8m9n2o3p4q5")

  @@index([user_id])
  @@schema("cartapp_api")
}

// ORDER ITEMS
model order_items {
  id         Int     @id @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())

  orders   orders   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk1h2j3k4l5m6n7o8p9q0r1s2t3")
  products products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk4u5v6w7x8y9z0a1b2c3d4e5f6")

  @@unique([order_id, product_id], map: "uk_order_product")
  @@index([order_id])
  @@index([product_id])
  @@schema("cartapp_api")
}
